<UserControl x:Class="ScreenStats.App.Controls.RamWidgetControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ScreenStats.App.Controls">
    
    <Grid Margin="0, 0, 0, 10">
        <StackPanel>
            <TextBlock Text="{Binding Label}"
                       FontFamily="{Binding FontFamily}"
                       FontSize="{Binding FontSize}"
                       Foreground="White" />

            <TextBlock Text="{Binding UsageText}"
                       FontFamily="{Binding FontFamily}"
                       FontSize="{Binding ValueFontSize}"
                       FontWeight="Bold"
                       Foreground="{Binding Color}" />

            <controls:UsageBarControl Margin="0, 5, 0, 0" x:Name="Bar" />
        </StackPanel>
    </Grid>
</UserControl>