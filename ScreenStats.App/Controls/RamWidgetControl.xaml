<UserControl x:Class="ScreenStats.App.Controls.RamWidgetControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ScreenStats.App.Controls">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="0, 0, 0, 10">
        <StackPanel>
            <TextBlock Text="{Binding Config.Content}"
                       FontFamily="{Binding Config.FontFamily}"
                       FontSize="{Binding Config.Size}"
                       FontWeight="{Binding Config.FontWeight}"
                       FontStyle="{Binding Config.FontStyle}"
                       Foreground="White" />

            <TextBlock Text="{Binding UsageText}"
                       FontFamily="{Binding Config.FontFamily}"
                       FontSize="{Binding Config.ValueSize}"
                       FontWeight="Bold"
                       FontStyle="{Binding Config.FontStyle}"
                       Foreground="{Binding Config.Color}" />

            <controls:UsageBarControl
                Value="{Binding Usage}"
                BarColor="{Binding Config.Color}"
                Margin="0,5,0,0"
                Visibility="{Binding Config.ShowBar, Converter={StaticResource BooleanToVisibilityConverter}}" />

        </StackPanel>
    </Grid>
</UserControl>