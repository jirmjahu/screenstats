<UserControl x:Class="ScreenStats.App.Controls.DriveUsageControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ScreenStats.App.Controls">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="0, 0, 0, 10">
        <StackPanel>
            <TextBlock Text="{Binding DisplayText}"
                       FontFamily="{Binding FontFamily}"
                       FontSize="{Binding Size}"
                       Foreground="White" />

            <TextBlock Text="{Binding Usage, StringFormat={}{0}%}"
                       FontFamily="{Binding FontFamily}"
                       FontSize="{Binding ValueSize}"
                       FontWeight="Bold"
                       Foreground="{Binding Color}" />

            <controls:UsageBarControl
                Value="{Binding Usage}"
                BarColor="{Binding Color}"
                Margin="0,5,0,0"
                Visibility="{Binding ShowBar, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>
    </Grid>
</UserControl>