<UserControl x:Class="ScreenStats.App.Controls.MediaWidgetControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Image Source="{Binding Thumbnail}"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"
               Width="50"
               Margin="0, 0, 10, 0"
               Visibility="{Binding ShowThumbnail, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <StackPanel Grid.Column="1"
                    VerticalAlignment="Center">

            <TextBlock Text="{Binding Title}"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="White" />

            <TextBlock Text="{Binding Artist}"
                       FontSize="12"
                       Foreground="#E4E3E9"
                       Visibility="{Binding ShowArtist, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <TextBlock Text="{Binding StatusText}"
                       FontSize="12"
                       Foreground="#E4E3E9"
                       Visibility="{Binding ShowStatus, Converter={StaticResource BooleanToVisibilityConverter}}" />

        </StackPanel>

    </Grid>
</UserControl>